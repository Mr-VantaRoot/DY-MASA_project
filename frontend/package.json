{
  "name": "masa-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "ensure-vite-temp": "node -e \"require('fs').mkdirSync('node_modules/.vite-temp',{recursive:true})\"",
    "predev": "npm run ensure-vite-temp",
    "prebuild": "npm run ensure-vite-temp",
    "dev": "vite --configLoader runner --host 127.0.0.1 --port 5173",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
