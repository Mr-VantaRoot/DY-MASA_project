# Optional. Defaults to /api (proxied to http://127.0.0.1:8000 by Vite in dev/preview).
# Set VITE_API_BASE_URL only when the frontend talks to a backend directly (e.g. deployed API).
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Do not put a real terminal token in a frontend build or committed file.
# If the optional local terminal is enabled, set VITE_TERMINAL_TOKEN only in
# an untracked frontend/.env file for a trusted local browser.
